{
  "name": "hundkrets-app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "cd .. && [ -f scripts/install-git-hooks.sh ] && ./scripts/install-git-hooks.sh || true",
    "dev": "vinxi dev --host 0.0.0.0",
    "build": "vinxi build",
    "start": "vinxi start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:geocode": "node scripts/test-geocode.mjs",
    "setup:mailpit": "cd .. && node scripts/setup-mailpit.mjs",
    "test:email": "node scripts/test-email-flows.mjs",
    "test:pb-login": "node scripts/test-pb-admin-login.mjs",
    "seed": "node scripts/seed-malmo.mjs",
    "seed:postal": "cd .. && node scripts/seed-postal-codes.mjs",
    "favicon:transparent": "node scripts/make-favicon-transparent.mjs",
    "logo-icon:transparent": "node scripts/make-logo-icon-transparent.mjs"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.14.2",
    "@solidjs/start": "^1.2.1",
    "@types/leaflet": "^1.9.21",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "pocketbase": "^0.21.2",
    "solid-js": "^1.9.5",
    "vinxi": "^0.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "dotenv": "^17.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
