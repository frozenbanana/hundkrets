# Docker Compose - set before `docker compose up`
#
# URL the browser uses to reach PocketBase.
# - Same machine: http://localhost:8090
# - LAN access:   http://YOUR_SERVER_IP:8090
# - With domain:   https://pb.yourdomain.com
#
VITE_POCKETBASE_URL=http://localhost:8090

# Landing page map: auth so the server can list users (users list rule requires auth).
# Option A: Superuser (admin) credentials—recommended, no token expiry:
# POCKETBASE_ADMIN_EMAIL=your-admin@example.com
# POCKETBASE_ADMIN_PASSWORD=your-admin-password
#
# Option B: Service token from any user (token expires in ~2 weeks):
# POCKETBASE_SERVICE_TOKEN=eyJ...
