# Docker Compose - set before `docker compose up`
#
# URL the browser uses to reach PocketBase.
# - Same machine: http://localhost:8090
# - LAN access:   http://YOUR_SERVER_IP:8090
# - With domain:   https://pb.yourdomain.com
#
VITE_POCKETBASE_URL=http://localhost:8090

# Landing page map: put in app/.env so the server can list users (users list rule requires auth).
# Get token: curl -X POST http://localhost:8090/api/collections/users/auth-with-password -H "Content-Type: application/json" -d '{"identity":"user@example.com","password":"..."}' → copy "token" from response. Expires in ~2 weeks.
# VITE_POCKETBASE_SERVICE_TOKEN=eyJ...
