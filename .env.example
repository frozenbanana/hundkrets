# Docker Compose - set before `docker compose up`
#
# URL the browser uses to reach PocketBase.
# - Same machine: http://localhost:8090
# - LAN access:   http://YOUR_SERVER_IP:8090
# - With domain:   https://pb.yourdomain.com
#
VITE_POCKETBASE_URL=http://localhost:8090

# Public site URL for meta tags (og:url, canonical, etc). Set for production.
# VITE_SITE_URL=https://hundkrets.se

# Google OAuth: configure in PocketBase Admin > Collections > users > Edit > Options > OAuth2.
# In Google Cloud Console, add this redirect URI: {VITE_POCKETBASE_URL}/api/oauth2-redirect
#   - Dev:   http://localhost:8090/api/oauth2-redirect
#   - Prod:  https://api.hundkrets.se/api/oauth2-redirect
