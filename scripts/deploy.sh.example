#!/bin/bash

# Deploy Hundkrets to home server.
# Copy to deploy.sh and adjust hosts if needed.
# Prefer SSH keys. Uses the docker group (no sudo).
#
# SERVER_HOST defaults to the Tailscale name (MagicDNS). If Tailscale is down,
# set it to the current LAN address explicitly, e.g.:
#   SERVER_HOST=192.168.1.163 ./scripts/deploy.sh

set -euo pipefail

SERVER_HOST="${SERVER_HOST:-nixos}"
SERVER_USER="${SERVER_USER:-henry}"
DEPLOY_PATH="${DEPLOY_PATH:-/home/henry/Services/hundkrets}"
VITE_POCKETBASE_URL="${VITE_POCKETBASE_URL:-https://api.hundkrets.se}"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Working tree is dirty. Commit/push first, or set ALLOW_DIRTY=1 to deploy whatever is on origin."
  if [[ "${ALLOW_DIRTY:-}" != "1" ]]; then
    exit 1
  fi
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
echo "Pushing ${BRANCH}..."
git push -u origin HEAD

echo "Deploying to ${SERVER_USER}@${SERVER_HOST}:${DEPLOY_PATH}..."
ssh "${SERVER_USER}@${SERVER_HOST}" bash -s <<EOF
set -euo pipefail
cd "${DEPLOY_PATH}"
# Prefer the system Docker socket (SSH sessions may inherit a stale rootless DOCKER_HOST)
unset DOCKER_HOST
export DOCKER_HOST=unix:///var/run/docker.sock
echo "📥 Pulling..."
git fetch origin
git checkout ${BRANCH}
git pull --ff-only origin ${BRANCH}
echo "🔨 Building (VITE_POCKETBASE_URL=${VITE_POCKETBASE_URL})..."
export VITE_POCKETBASE_URL="${VITE_POCKETBASE_URL}"
docker compose build --no-cache pocketbase app
echo "🚀 Starting..."
docker compose up -d
docker compose ps
echo "✅ Deploy finished at \$(date -Is)"
EOF

echo "Done. Site: https://hundkrets.se"
